{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rustdoc-query:schema:v1",
  "title": "rustdoc-query public API v1",
  "description": "Schema-first contract for the rustdoc-query library and MCP adapter. The root is a registry of named contract types; consumers select a named definition with $ref.",
  "x-mcp-tools": [
    { "name": "crate_overview", "request": "OverviewRequest", "outcome": "OverviewOutcome" },
    { "name": "find_items", "request": "FindRequest", "outcome": "FindOutcome" },
    { "name": "get_item", "request": "GetItemRequest", "outcome": "GetItemOutcome" }
  ],
  "$defs": {
    "OutputFormat": {
      "type": "string",
      "enum": ["toon", "json"],
      "default": "json",
      "description": "Encoding of the canonical generated outcome selected by a library or MCP consumer."
    },
    "RequestedVersion": {
      "type": "string",
      "minLength": 1,
      "default": "latest",
      "description": "A crates.io version or the literal latest."
    },
    "IncludeSummary": {
      "type": "boolean",
      "default": true,
      "description": "Include a concise documentation summary for each result."
    },
    "PageCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Opaque continuation cursor returned by an earlier find_items page."
    },
    "PageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 50,
      "description": "Maximum rows to return in this page."
    },
    "CrateName": {
      "type": "string",
      "minLength": 1,
      "description": "Crate name as published on crates.io."
    },
    "DependencyVersion": {
      "type": "string",
      "minLength": 1,
      "description": "The caller's resolved dependency version."
    },
    "PublicModulePath": {
      "type": "string",
      "minLength": 1,
      "description": "A public Rust module path."
    },
    "PublicItemPath": {
      "type": "string",
      "minLength": 1,
      "description": "A public Rust item path, optionally ending in an inherent method name."
    },
    "DocumentationQuery": {
      "type": "string",
      "minLength": 1,
      "description": "A non-empty full-text query over documentation and signatures."
    },
    "RustdocItemKind": {
      "type": "string",
      "enum": ["module", "extern_crate", "use", "struct", "struct_field", "union", "enum", "variant", "function", "type_alias", "constant", "trait", "trait_alias", "impl", "static", "extern_type", "macro", "proc_attribute", "proc_derive", "assoc_const", "assoc_type", "primitive", "keyword", "attribute"],
      "description": "Exact rustdoc item kind. Values preserve rustdoc JSON distinctions and are never normalized into a lossy category."
    },
    "VariantKind": {
      "type": "string",
      "enum": ["unit", "tuple", "struct"],
      "description": "The field shape of an enum variant. This is distinct from RustdocItemKind."
    },
    "CacheSource": {
      "type": "string",
      "enum": ["memory", "sidecar", "blob", "network"],
      "description": "The cache tier or source that supplied the rustdoc data."
    },
    "CacheMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/CacheSource" },
        "status": {
          "type": "string",
          "enum": ["hit", "miss"],
          "description": "Whether this request found usable data at the reported cache tier."
        },
        "load_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Elapsed time spent preparing the queried crate."
        },
        "stale": {
          "type": "boolean",
          "description": "Whether the returned data is known to be stale."
        },
        "age_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Age of the durable source when known."
        }
      },
      "required": ["source", "status", "load_duration_ms", "stale"]
    },
    "VersionComparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_version": { "type": "string" },
        "resolved_version": { "type": "string" },
        "dependency_version": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["matched", "mismatch", "not_compared"]
        },
        "message": { "type": "string" }
      },
      "required": ["requested_version", "resolved_version", "status", "message"]
    },
    "ResponseMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cache": { "$ref": "#/$defs/CacheMetadata" },
        "version": { "$ref": "#/$defs/VersionComparison" }
      },
      "required": ["version"]
    },
    "OverviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crate_name": { "$ref": "#/$defs/CrateName" },
        "version": { "$ref": "#/$defs/RequestedVersion" },
        "dependency_version": { "$ref": "#/$defs/DependencyVersion" },
        "module": { "$ref": "#/$defs/PublicModulePath" },
        "full_docs": {
          "type": "boolean",
          "default": false,
          "description": "Include full module documentation rather than its first paragraph."
        },
        "output_format": { "$ref": "#/$defs/OutputFormat" }
      },
      "required": ["crate_name"]
    },
    "FindRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crate_name": { "$ref": "#/$defs/CrateName" },
        "version": { "$ref": "#/$defs/RequestedVersion" },
        "dependency_version": { "$ref": "#/$defs/DependencyVersion" },
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Fuzzy item-name query."
        },
        "doc_query": { "$ref": "#/$defs/DocumentationQuery" },
        "kind": { "$ref": "#/$defs/RustdocItemKind" },
        "module": { "$ref": "#/$defs/PublicModulePath" },
        "with_summary": { "$ref": "#/$defs/IncludeSummary" },
        "cursor": { "$ref": "#/$defs/PageCursor" },
        "page_size": { "$ref": "#/$defs/PageSize" },
        "output_format": { "$ref": "#/$defs/OutputFormat" }
      },
      "required": ["crate_name"],
      "dependentSchemas": {
        "query": {
          "not": { "required": ["doc_query"] }
        },
        "doc_query": {
          "not": { "required": ["query"] }
        }
      }
    },
    "GetItemRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crate_name": { "$ref": "#/$defs/CrateName" },
        "version": { "$ref": "#/$defs/RequestedVersion" },
        "dependency_version": { "$ref": "#/$defs/DependencyVersion" },
        "path": { "$ref": "#/$defs/PublicItemPath" },
        "include_impls": {
          "type": "boolean",
          "default": false,
          "description": "Include blanket implementations."
        },
        "full_docs": {
          "type": "boolean",
          "default": false,
          "description": "Include full item documentation rather than its first paragraph."
        },
        "output_format": { "$ref": "#/$defs/OutputFormat" }
      },
      "required": ["crate_name", "path"]
    },
    "Field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["name", "type"]
    },
    "Variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/VariantKind" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/Field" }
        }
      },
      "required": ["name", "kind", "fields"]
    },
    "Method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "signature": { "type": "string" },
        "impl_constraint": {
          "type": "string",
          "description": "Implementation context distinguishing otherwise identical inherent methods. Uses a concrete target or generic implementation header."
        }
      },
      "required": ["name", "signature"]
    },
    "AssociatedType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "bounds": { "type": "string" },
        "default": { "type": "string" }
      },
      "required": ["name", "bounds"]
    },
    "AssociatedConst": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["name", "type"]
    },
    "OverviewItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "kind": { "$ref": "#/$defs/RustdocItemKind" },
        "summary": { "type": "string" },
        "signature": { "type": "string" },
        "deprecated": { "type": "boolean" },
        "reexport": { "type": "boolean" }
      },
      "required": ["name", "path", "kind", "summary", "deprecated", "reexport"]
    },
    "KindCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "#/$defs/RustdocItemKind" },
        "count": { "type": "integer", "minimum": 0 }
      },
      "required": ["kind", "count"]
    },
    "Totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direct": { "type": "array", "items": { "$ref": "#/$defs/KindCount" } },
        "subtree": { "type": "array", "items": { "$ref": "#/$defs/KindCount" } }
      },
      "required": ["direct", "subtree"]
    },
    "Overview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "resolved_version": { "type": "string" },
        "docs": { "type": "string" },
        "docs_truncated": { "type": "boolean" },
        "totals": { "$ref": "#/$defs/Totals" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/OverviewItem" } }
      },
      "required": ["path", "resolved_version", "docs_truncated", "totals", "items"]
    },
    "FindRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "kind": { "$ref": "#/$defs/RustdocItemKind" },
        "summary": { "type": "string" }
      },
      "required": ["path", "kind"]
    },
    "FindResult": {
      "oneOf": [
        {
          "title": "FindCompletePage",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rows": { "type": "array", "items": { "$ref": "#/$defs/FindRow" } },
            "has_more": { "enum": [false] },
            "resolved_version": { "type": "string" },
            "hint": { "type": "string" }
          },
          "required": ["rows", "has_more", "resolved_version"]
        },
        {
          "title": "FindContinuationPage",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rows": { "type": "array", "items": { "$ref": "#/$defs/FindRow" } },
            "next_cursor": { "$ref": "#/$defs/PageCursor" },
            "has_more": { "enum": [true] },
            "resolved_version": { "type": "string" },
            "hint": { "type": "string" }
          },
          "required": ["rows", "next_cursor", "has_more", "resolved_version"]
        }
      ]
    },
    "ItemDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "kind": { "$ref": "#/$defs/RustdocItemKind" },
        "docs": { "type": "string" },
        "docs_truncated": { "type": "boolean" },
        "signature": { "type": "string" },
        "impl_constraint": {
          "type": "string",
          "description": "Implementation context for an inherent method. Uses a concrete target or generic implementation header."
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/Field" } },
        "variants": { "type": "array", "items": { "$ref": "#/$defs/Variant" } },
        "non_exhaustive": { "type": "boolean" },
        "methods": { "type": "array", "items": { "$ref": "#/$defs/Method" } },
        "required_methods": { "type": "array", "items": { "$ref": "#/$defs/Method" } },
        "provided_methods": { "type": "array", "items": { "$ref": "#/$defs/Method" } },
        "assoc_types": { "type": "array", "items": { "$ref": "#/$defs/AssociatedType" } },
        "consts": { "type": "array", "items": { "$ref": "#/$defs/AssociatedConst" } },
        "trait_impls": { "type": "array", "items": { "type": "string" } },
        "derives": { "type": "array", "items": { "type": "string" } },
        "auto_traits": { "type": "array", "items": { "type": "string" } },
        "blanket_impls": { "type": "array", "items": { "type": "string" } },
        "resolved_version": { "type": "string" }
      },
      "required": [
        "path", "kind", "docs_truncated", "fields", "variants", "non_exhaustive",
        "methods", "required_methods", "provided_methods", "assoc_types", "consts",
        "trait_impls", "derives", "auto_traits", "resolved_version"
      ]
    },
    "InvalidRequestError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "enum": ["invalid_request"] },
        "message": { "type": "string" },
        "field": { "type": "string" }
      },
      "required": ["code", "message"]
    },
    "CrateNotFoundError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "enum": ["crate_not_found"] },
        "message": { "type": "string" },
        "crate_name": { "type": "string" },
        "resolved_version": { "type": "string" }
      },
      "required": ["code", "message", "crate_name", "resolved_version"]
    },
    "ModuleNotFoundError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "enum": ["module_not_found"] },
        "message": { "type": "string" },
        "crate_name": { "type": "string" },
        "resolved_version": { "type": "string" },
        "module": { "type": "string" }
      },
      "required": ["code", "message", "crate_name", "resolved_version", "module"]
    },
    "ItemNotFoundError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "enum": ["item_not_found"] },
        "message": { "type": "string" },
        "crate_name": { "type": "string" },
        "resolved_version": { "type": "string" },
        "path": { "type": "string" }
      },
      "required": ["code", "message", "crate_name", "resolved_version", "path"]
    },
    "UnsupportedRustdocFormatError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "enum": ["unsupported_rustdoc_format"] },
        "message": { "type": "string" },
        "found": { "type": "integer", "minimum": 0 }
      },
      "required": ["code", "message", "found"]
    },
    "SourceUnavailableError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "enum": ["source_unavailable"] },
        "message": { "type": "string" },
        "retryable": { "type": "boolean", "enum": [true] }
      },
      "required": ["code", "message", "retryable"]
    },
    "OperationFailedError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "enum": ["operation_failed"] },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "diagnostic_id": { "type": "string" }
      },
      "required": ["code", "message", "retryable"]
    },
    "ApiError": {
      "oneOf": [
        { "$ref": "#/$defs/InvalidRequestError" },
        { "$ref": "#/$defs/CrateNotFoundError" },
        { "$ref": "#/$defs/ModuleNotFoundError" },
        { "$ref": "#/$defs/ItemNotFoundError" },
        { "$ref": "#/$defs/UnsupportedRustdocFormatError" },
        { "$ref": "#/$defs/SourceUnavailableError" },
        { "$ref": "#/$defs/OperationFailedError" }
      ]
    },
    "OverviewSuccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["ok"] },
        "result": { "$ref": "#/$defs/Overview" },
        "metadata": { "$ref": "#/$defs/ResponseMetadata" }
      },
      "required": ["status", "result", "metadata"]
    },
    "FindSuccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["ok"] },
        "result": { "$ref": "#/$defs/FindResult" },
        "metadata": { "$ref": "#/$defs/ResponseMetadata" }
      },
      "required": ["status", "result", "metadata"]
    },
    "GetItemSuccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["ok"] },
        "result": { "$ref": "#/$defs/ItemDetail" },
        "metadata": { "$ref": "#/$defs/ResponseMetadata" }
      },
      "required": ["status", "result", "metadata"]
    },
    "ErrorOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["error"] },
        "error": { "$ref": "#/$defs/ApiError" }
      },
      "required": ["status", "error"]
    },
    "OverviewOutcome": {
      "oneOf": [
        { "$ref": "#/$defs/OverviewSuccess" },
        { "$ref": "#/$defs/ErrorOutcome" }
      ]
    },
    "FindOutcome": {
      "oneOf": [
        { "$ref": "#/$defs/FindSuccess" },
        { "$ref": "#/$defs/ErrorOutcome" }
      ]
    },
    "GetItemOutcome": {
      "oneOf": [
        { "$ref": "#/$defs/GetItemSuccess" },
        { "$ref": "#/$defs/ErrorOutcome" }
      ]
    }
  }
}
